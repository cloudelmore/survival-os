[Unit]
Description=SURVIVAL OS web server
After=survival-api.service

[Service]
User=www-data
Group=www-data
RuntimeDirectory=survival-web
ExecStart=/usr/sbin/nginx -c /opt/survival-os/nginx.conf -e stderr -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
