[Unit]
Description=SURVIVAL OS library indexer
After=survival-api.service

[Service]
User=survival
Group=survival
WorkingDirectory=/opt/survival-os
Environment=SURVIVAL_STATE_DIR=/var/lib/survival-os
ExecStart=/opt/survival-os/venv/bin/survival-indexer
Restart=always
RestartSec=10
# Always behind the dashboard, search and Kiwix.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
CPUQuota=100%
MemoryMax=768M
StateDirectory=survival-os
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
