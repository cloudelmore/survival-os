[Unit]
Description=SURVIVAL OS Kiwix server

[Service]
User=survival
Group=survival
Environment=LIBRARY=/var/lib/survival-os/content/kiwix-library.xml
ExecStartPre=+/usr/bin/install -d -o survival -g survival -m 700 /var/lib/survival-os/content
ExecStartPre=/bin/sh -c 'test -s "$LIBRARY" || echo "<library></library>" > "$LIBRARY"'
ExecStart=/usr/bin/kiwix-serve --address=127.0.0.1 --port=8082 --monitorLibrary --skipInvalid --library ${LIBRARY}
Restart=always
RestartSec=5
Nice=5
MemoryMax=1G
StateDirectory=survival-os
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
